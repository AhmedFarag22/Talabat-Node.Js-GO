HTTP_PORT=4100
LOG_LEVEL=info
APP_ENV=development

# Mongo
MONGO_URI=mongodb://localhost:27017
MONGO_DB=analytics

# RabbitMQ — must match order-service's outbound exchange
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_ORDER_EVENTS_EXCHANGE=order.events
RABBITMQ_ORDER_EVENTS_QUEUE=analytics-service.order-events
RABBITMQ_ORDER_EVENTS_BINDINGS=order.#,payment.#
RABBITMQ_ORDER_EVENTS_DLX=order.events.dlx
RABBITMQ_ORDER_EVENTS_DLQ=analytics-service.order-events.dlq
RABBITMQ_PREFETCH=32

# RabbitMQ — core.events stream, consumed only for RBAC cache invalidation
RABBITMQ_CORE_EVENTS_EXCHANGE=core.events
RABBITMQ_CORE_EVENTS_QUEUE=analytics-service.core-events
RABBITMQ_CORE_EVENTS_BINDINGS=rbac.#
RABBITMQ_CORE_EVENTS_DLX=core.events.dlx
RABBITMQ_CORE_EVENTS_DLQ=analytics-service.core-events.dlq

# JWT — same secret as core/order so the same token works
ACCESS_SECRET=devsecret-replace-me
ACCESS_COOKIE_NAME=access_token

# Internal service-to-service
INTERNAL_API_KEY=devkey-replace-me

# core-service (read-through for RBAC permissions)
CORE_SERVICE_BASE_URL=http://localhost:3000
CORE_INTERNAL_API_KEY=devkey-replace-me
RBAC_CACHE_TTL_SEC=300
